// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//Définition unique des langues
enum Language {
  FR
  BR
}
//définition des composants app pour article
enum ArticleComponentKey {
  APP_JBDB
  APP_DICTATION
}



// ==============================================================================================
// =========================== DONNEES GENERALES ================================================
// ==============================================================================================

model Grade {
  gradeId   Int    @id @default(autoincrement())
  gradeName String @db.VarChar(50)
  
  // Relation n-n via la table pivot
  articleGrades ArticleGrade[]
  
  users User[]
}

model Domaine {
  id       String @id // ex: "langue"
  titleKey String // Clé i18n: "domaine.francais"
  color    String // Pour ton css (ex: "francais")

  // SES ENFANTS
  sousDomaines SousDomaine[]
  articles     Article[]
}

model SousDomaine {
  id       String  @id // ex: "lexique"
  titleKey String  // Clé i18n: "main.sousdomaine.lexique"
  color    String? // Sa propre couleur

  // LE LIEN PARENT
  domaineId String
  domaine   Domaine @relation(fields: [domaineId], references: [id])

  // SES ENFANTS
  articles Article[]
}

// ==============================================================================================
// =========================== PARTIE PUBLIQUE ==================================================
// ==============================================================================================

model Article {
  id             Int      @id @default(autoincrement())
  titleKey       String
  descriptionKey String
  logoSrc        String
  logoAlt        String   @default("logo")
  languages      Language[]
  createdAt      DateTime @default(now())
  componentKey   ArticleComponentKey?

  // Relations
  links        Articlelink[]
  articleGrades ArticleGrade[] // Relation inverse nécessaire pour la table pivot

  domaineId     String?
  domaine       Domaine?      @relation(fields: [domaineId], references: [id])
  
  sousDomaineId String?
  sousDomaine   SousDomaine?  @relation(fields: [sousDomaineId], references: [id])

  @@map("article")
}

// Table de jonction pour la relation Many-to-Many entre Article et Grade
model ArticleGrade {
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int

  grade   Grade @relation(fields: [gradeId], references: [gradeId], onDelete: Cascade)
  gradeId Int

  @@id([articleId, gradeId])
}

model Articlelink {
  id Int @id @default(autoincrement())

  articleId Int
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  index Int        // 1,2,3 pour <1>, <2>
  label String     // Charivari
  url String
}



// ==============================================================================================
// =========================== PARTIE PRIVEE ====================================================
// ==============================================================================================

// ############################ GESTION DES UTILISATEURS ################################################
model User {
   userId             Int     @id @default(autoincrement())
   userFamilyName String  @db.VarChar(50)
   userFirstName String  @db.VarChar(50)
   userPseudo String? @db.VarChar(50)   @unique
   userPsswd String? @db.VarChar(255) 
   userMail String? @db.VarChar(255) @unique
   userIcon String @db.VarChar(50) @default("user_student.png")

   gradeId        Int?    // clé étrangère optionnelle donc NULL si pas d'association avec un niveau scolaire
   grade          Grade? @relation(fields: [gradeId], references: [gradeId], onDelete: SetNull)

   schoolId Int? // clé étrangère optionnelle donc NULL si pas d'association avec une école
   school   School? @relation(fields: [schoolId], references: [schoolId], onDelete: SetNull)

  userLinks LinkUser[] 
  userGroups GroupUser[]
  userRoles RoleUser[]
  userLinkPermissions LienPermission[]
  bookEvents BookEvent[]

  @@unique([userFirstName, userFamilyName, schoolId])
}

model Role {
  roleId Int @id @default(autoincrement())
  roleName String @db.VarChar(50)

  roleUsers RoleUser[]
}

model RoleUser{
  user   User  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId Int

  roles        Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  roleId      Int

  @@id([userId, roleId]) // clé composite
}

model GroupUser {
  user   User  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId Int

  group        Group       @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
  groupId      Int

  principal Boolean @default(false)

  @@id([userId, groupId]) // clé composite
}

// ############################ DONNEES ECOLE ###################################################
model School {
  schoolId   Int    @id @default(autoincrement())
  schoolName String @db.VarChar(500)
  schoolRef  String @unique
  schoolCp  Int
  schoolCity String
  classrooms  Classroom[] // Relation 1-n avec Classroom
  users User[] //relation 1-n avec user

  @@unique([schoolName, schoolCp, schoolCity])
}

model Classroom {
  classroomId   Int    @id @default(autoincrement())
  classroomNumber Int //le numéro de la salle
  classroomOrder Int @default(0) // 👈 valeur par défaut, ordre d'affichage des classes
  classroomBorderColor String @db.VarChar(255)
  classroomBackgroundColor String @db.VarChar(255)
  classroomColor String @db.VarChar(255)
  classroomRef String @unique
  schoolId        Int?    // clé étrangère optionnelle donc NULL si pas d'association avec une école
  school          School? @relation(fields: [schoolId], references: [schoolId], onDelete: SetNull)

  @@unique([classroomRef, schoolId])
  groupId Int?      @unique  // clé étrangère optionnelle vers Group
  group   Group?     @relation(fields: [groupId], references: [groupId], onDelete: SetNull)
}

model Group {
  groupId Int     @id @default(autoincrement())
  groupName String @db.VarChar(255)
  groupLanguage String @db.VarChar(50)
  groupPrincipal Boolean

  classroom Classroom?  // relation 1-1 inverse
  groupLinks GroupLink[] // Relation avec la table de liaison GroupLink
  groupUsers GroupUser[]
  libraryGroup BookGroup[]
  groupPeriods Periodlibrary[]
}


// ############################ RACCOURCI INTERNENT PAGE D'ACCUEIL ############################
model Link {
  linkId             Int     @id @default(autoincrement())
  linkName           String  @db.VarChar(500)

  linkTitleFr        String @db.VarChar(500) @default("")
  linkTitleBr        String @db.VarChar(500) @default("")
  linkFullNameFr     String @db.VarChar(500) @default("")
  linkFullNameBr     String @db.VarChar(500) @default("")

  linkRedirection    String
  linkIcon           String  @db.VarChar(255)
  linkMatter         String  @db.VarChar(50)

  linkDescriptionFr  String @db.Text @default("")
  linkDescriptionBr  String @db.Text @default("")

  linkType           String  @db.VarChar(50) @default("all")

  groupLinks GroupLink[] // Relation avec la table de liaison GroupLink
  userLinks LinkUser[] // Relation avec la table de liaison GroupLink
  linkUserPermission LienPermission[] // Relation avec la table de liaison LienPermission
}

model GroupLink {
  group   Group  @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
  groupId Int

  link        Link       @relation(fields: [linkId], references: [linkId], onDelete: Cascade)
  linkId      Int

  @@id([groupId, linkId]) // clé composite
}

model LinkUser {
  user   User  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId Int

  link        Link       @relation(fields: [linkId], references: [linkId], onDelete: Cascade)
  linkId      Int

  @@id([userId, linkId]) // clé composite
}

model LienPermission {
  plId Int @id @default(autoincrement())

  links Link @relation(fields: [linkId], references: [linkId], onDelete: Cascade)
  linkId Int

  users User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  userId Int
}

// ############################ LIBRARY ########################################################

model Book {
  bookId Int @id @default(autoincrement())
  bookTitle String @db.VarChar(255)
  bookAuthor String? @db.VarChar(100)
  bookPublisher String? @db.VarChar(100)
  bookIsbn String? @db.VarChar(25) 

  libraryGroup BookGroup[] 
}

model BookEvent{
  bookEventId Int @id @default(autoincrement())
  bookEventType Int
  bookEventDate DateTime
  userId Int
  bookGroupId Int

  // Relations
  groupBook  BookGroup  @relation(fields: [bookGroupId], references: [bookGroupId])
  user User @relation(fields: [userId], references: [userId])
  eventLibraryType Eventlibrarytype @relation(fields: [bookEventType], references: [eventLibraryTypeId])
}

model Periodlibrary {
  periodId Int @id @default(autoincrement())
  groupId Int?
  periodName String @db.VarChar(50)
  dateStart DateTime
  dateEnd DateTime

  group Group? @relation(fields: [groupId], references: [groupId], onDelete: SetNull)
}

model BookGroup {
  bookGroupId Int @id @default(autoincrement())
  bookId Int
  groupId Int
  location String
  onWork Boolean
  dateAdd DateTime
  dateRemove DateTime?

  // Relations
  book  Book  @relation(fields: [bookId], references: [bookId])
  group Group @relation(fields: [groupId], references: [groupId])
  bookEvents BookEvent[]
}

model Eventlibrarytype {
  eventLibraryTypeId Int @id @default(autoincrement())
  eventLibraryTypeName String @db.VarChar(50)

  bookEvents BookEvent[]
}





